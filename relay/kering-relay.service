[Unit]
Description=Kering Claude relay for Ask Kering (Sonnet 5.5), behind nginx at /bali/kering/api/
After=network-online.target
Wants=network-online.target

[Service]
User=kering-relay
Group=kering-relay
# ANTHROPIC_API_KEY, EVENT_CODE, MODEL. Root-only file; the agents' user (kering-agent) cannot read it.
EnvironmentFile=/etc/kering-relay/relay.env
Environment=PORT=8787
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/kering-relay/kering-relay.mjs
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
